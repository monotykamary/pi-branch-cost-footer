{
  "name": "pi-branch-cost-footer",
  "version": "1.2.0",
  "description": "pi footer extension that shows cumulative token usage and cost for the current session branch only, not the whole session.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc -p tsconfig.json",
    "lint:dead": "knip --no-gitignore",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pi",
    "pi-package",
    "extension",
    "footer",
    "cost",
    "branch",
    "session",
    "tokens",
    "usage"
  ],
  "author": "monotykamary",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "24.12.4",
    "knip": "6.14.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-branch-cost-footer.git"
  },
  "homepage": "https://github.com/monotykamary/pi-branch-cost-footer#readme",
  "bugs": {
    "url": "https://github.com/monotykamary/pi-branch-cost-footer/issues"
  },
  "packageManager": "pnpm@11.6.0"
}
